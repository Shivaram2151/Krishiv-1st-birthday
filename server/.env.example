# ── Server (never commit the real .env) ──────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, Render, local…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/krishiv_birthday?schema=public"

# Long random secret for the organizer dashboard (/admin) and admin API.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Comma-separated list of sites allowed to call this API (your deployed frontend).
ALLOWED_ORIGINS=http://localhost:5173,https://your-invitation.vercel.app

# Set to "true" to publish wishes immediately (skips moderation). Default: false.
AUTO_APPROVE_WISHES=false

# Must match maxGuestsPerRsvp in the frontend eventConfig.js
MAX_GUESTS_PER_RSVP=6

PORT=4000
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Fly, Heroku…)
TRUST_PROXY=1
